<Application
    x:Class="ReelScope.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Fluent 2 Glassmorphism and Neon Accents -->
            <SolidColorBrush x:Key="ReelScopeAccentGlow" Color="#0078D4" />
            <SolidColorBrush x:Key="ReelScopeCyanGlow" Color="#00D2FF" />
            <SolidColorBrush x:Key="CardBackgroundMica" Color="#1C2128" Opacity="0.75" />
            <SolidColorBrush x:Key="CardBorderGlass" Color="#30363D" Opacity="0.5" />
            <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
        </ResourceDictionary>
    </Application.Resources>
</Application>
