<Page
    x:Class="ReelScope.App.Views.SegmentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="16,0,16,24">
            <!-- Header and Clustering Controls (Reference 6) -->
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                <StackPanel>
                    <TextBlock Text="Audience &amp; Content Segments" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="Cluster creators, posts, and behaviors using KMeans" FontSize="14" Foreground="#8B949E" Margin="0,4,0,0"/>
                </StackPanel>

                <ComboBox Grid.Column="1" Header="Clustering Method" SelectedIndex="0" CornerRadius="6">
                    <ComboBoxItem Content="K-Means"/>
                    <ComboBoxItem Content="DBSCAN"/>
                </ComboBox>

                <ComboBox Grid.Column="2" Header="Segments (k)" SelectedIndex="2" CornerRadius="6">
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                    <ComboBoxItem Content="4"/>
                    <ComboBoxItem Content="5"/>
                    <ComboBoxItem Content="6"/>
                </ComboBox>

                <ComboBox Grid.Column="3" Header="Feature Set" SelectedIndex="0" CornerRadius="6">
                    <ComboBoxItem Content="Content + Audience"/>
                    <ComboBoxItem Content="Performance Only"/>
                </ComboBox>

                <Button Grid.Column="4" Content="Run Analysis" Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Bottom" CornerRadius="6" Padding="16,8"/>
            </Grid>

            <!-- 4 Segment Archetype Cards (Reference 6) -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                <!-- Viral Short -->
                <Border Background="#1C2128" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1" Padding="16">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7A6;" FontSize="14" Foreground="#FFA657"/>
                            <TextBlock Text="Viral Short" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="12.4K items  ↑ 28%" FontSize="13" Foreground="#3FB950"/>
                        <TextBlock Text="Short, highly shareable content that spikes quickly." FontSize="11" Foreground="#8B949E" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- High Engagement -->
                <Border Grid.Column="1" Background="#1C2128" CornerRadius="12" BorderBrush="#0078D4" BorderThickness="1.5" Padding="16">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE77B;" FontSize="14" Foreground="#00D2FF"/>
                            <TextBlock Text="High Engagement" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="28.7K items  ↑ 12%" FontSize="13" Foreground="#3FB950"/>
                        <TextBlock Text="Consistent high engagement across audience segments." FontSize="11" Foreground="#8B949E" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Slow Burner -->
                <Border Grid.Column="2" Background="#1C2128" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1" Padding="16">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEC05;" FontSize="14" Foreground="#7EE787"/>
                            <TextBlock Text="Slow Burner" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="18.9K items  ↑ 6%" FontSize="13" Foreground="#3FB950"/>
                        <TextBlock Text="Gradual growth with long-tail performance." FontSize="11" Foreground="#8B949E" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Underperformer -->
                <Border Grid.Column="3" Background="#1C2128" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1" Padding="16">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEB90;" FontSize="14" Foreground="#F85149"/>
                            <TextBlock Text="Underperformer" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="9.2K items  ↓ 18%" FontSize="13" Foreground="#F85149"/>
                        <TextBlock Text="Low engagement and limited reach compared to peers." FontSize="11" Foreground="#8B949E" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Mid Row: 2D Clusters Scatter + Radar Profile + Top Features -->
            <Grid ColumnDefinitions="1.2*,1.1*,*" ColumnSpacing="16">
                <!-- 2D Scatter -->
                <Border Background="#1C2128" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Segment Clusters" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Each point represents a post colored by segment" FontSize="11" Foreground="#8B949E"/>
                        <Border Height="200" Background="#0D1117" CornerRadius="8">
                            <WebView2 x:Name="ClusterScatterWebView"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Radar Chart -->
                <Border Grid.Column="1" Background="#1C2128" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Segment Profile Comparison" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Normalized multi-axis radar profile" FontSize="11" Foreground="#8B949E"/>
                        <Border Height="200" Background="#0D1117" CornerRadius="8">
                            <WebView2 x:Name="RadarWebView"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Top Features List -->
                <Border Grid.Column="2" Background="#1C2128" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Top Features" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="What defines High Engagement" FontSize="11" Foreground="#8B949E"/>
                        <ItemsControl x:Name="TopFeaturesList"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom Table: Segment Statistics -->
            <Border Background="#1C2128" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Segment Statistics" FontSize="15" FontWeight="SemiBold"/>
                    <ListView x:Name="SegmentStatsListView" Height="160"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
