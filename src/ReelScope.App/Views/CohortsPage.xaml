<Page
    x:Class="ReelScope.App.Views.CohortsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Padding="16,0,16,24">
            <!-- Header -->
            <StackPanel>
                <TextBlock Text="Cohort Analysis" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Retention and growth patterns across content cohorts" FontSize="14" Foreground="#8B949E" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 4 KPI Cards (Reference 4) -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                <Border Background="#1C2128" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Avg 7-Day Retention" FontSize="12" Foreground="#8B949E"/>
                        <TextBlock Text="28.4%" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="↑ 12% vs. previous 28 days" FontSize="11" Foreground="#3FB950"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#1C2128" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Avg 30-Day Engagement" FontSize="12" Foreground="#8B949E"/>
                        <TextBlock Text="6.2%" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="↑ 18% vs. previous 28 days" FontSize="11" Foreground="#3FB950"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#1C2128" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Avg 30-Day Saves" FontSize="12" Foreground="#8B949E"/>
                        <TextBlock Text="4.8%" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="↑ 24% vs. previous 28 days" FontSize="11" Foreground="#3FB950"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Background="#1C2128" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Cohort Follower Growth" FontSize="12" Foreground="#8B949E"/>
                        <TextBlock Text="+12.6K" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="↑ 32% vs. previous 28 days" FontSize="11" Foreground="#3FB950"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Mid Section: Retention Heatmap + Insights -->
            <Grid ColumnDefinitions="2*,*" ColumnSpacing="16">
                <!-- Heatmap Container -->
                <Border Background="#1C2128" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1" Padding="20">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <StackPanel>
                                <TextBlock Text="Cohort Retention Heatmap" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Percentage of initial views retained over time" FontSize="11" Foreground="#8B949E"/>
                            </StackPanel>
                            <!-- Metric switch tabs -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="0,0,12,0">
                                <Button Content="Views" CornerRadius="6" Style="{ThemeResource AccentButtonStyle}"/>
                                <Button Content="Engagement" CornerRadius="6"/>
                                <Button Content="Saves" CornerRadius="6"/>
                            </StackPanel>
                            <!-- Resolution pills -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                <Button Content="24h" CornerRadius="6"/>
                                <Button Content="3d" CornerRadius="6"/>
                                <Button Content="7d" CornerRadius="6" Style="{ThemeResource AccentButtonStyle}"/>
                                <Button Content="30d" CornerRadius="6"/>
                            </StackPanel>
                        </Grid>
                        <!-- WebView2 Heatmap -->
                        <Border Height="260" Background="#0D1117" CornerRadius="8">
                            <WebView2 x:Name="HeatmapWebView"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Cohort Insights -->
                <Border Grid.Column="1" Background="#1C2128" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Cohort Insights" FontSize="16" FontWeight="SemiBold"/>
                        <ItemsControl x:Name="CohortInsightsList"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom Row: Cohort Decay Trends + Summary Table -->
            <Grid ColumnDefinitions="1.2*,*" ColumnSpacing="16">
                <!-- Trends Curves -->
                <Border Background="#1C2128" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Cohort Trends" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Retention rate decay by cohort month" FontSize="11" Foreground="#8B949E"/>
                        <Border Height="180" Background="#0D1117" CornerRadius="8">
                            <WebView2 x:Name="TrendsWebView"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Summary Table -->
                <Border Grid.Column="1" Background="#1C2128" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1" Padding="16">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Cohort Summary" FontSize="15" FontWeight="SemiBold"/>
                            <Button Grid.Column="1" Content="Export" CornerRadius="6"/>
                        </Grid>
                        <ListView x:Name="SummaryListView" Height="180"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
