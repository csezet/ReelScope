<Page
    x:Class="ReelScope.App.Views.ImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Padding="16,0,16,24">
            <!-- Header -->
            <StackPanel>
                <TextBlock Text="Import Data" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Bring in creator analytics from CSV, Excel, or platform exports" FontSize="14" Foreground="#8B949E" Margin="0,4,0,0"/>
            </StackPanel>

            <Grid ColumnDefinitions="1.1*,1.4*" ColumnSpacing="20">
                <!-- Left Column: Upload Zone, Presets & Wizard Stepper -->
                <StackPanel Spacing="16">
                    <!-- Drag and Drop Box -->
                    <Border
                        Background="#161B22"
                        CornerRadius="12"
                        BorderBrush="#0078D4"
                        BorderThickness="1.5"
                        Padding="32"
                        HorizontalAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Center" Spacing="10">
                            <Border Width="48" Height="48" CornerRadius="24" Background="#1C2128" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE898;" FontSize="22" Foreground="#58A6FF"/>
                            </Border>
                            <TextBlock Text="Drag and drop your file here" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="or click to browse" FontSize="13" Foreground="#58A6FF" HorizontalAlignment="Center"/>
                            <TextBlock Text="Supports CSV, Excel (.xlsx, .xls), or JSON files up to 200MB" FontSize="11" Foreground="#8B949E" HorizontalAlignment="Center"/>
                            <Button Content="Select Local File" Click="OnBrowseFileClicked" HorizontalAlignment="Center" Margin="0,6,0,0" CornerRadius="6"/>
                        </StackPanel>
                    </Border>

                    <!-- Platform Presets (Reference 2) -->
                    <Border Background="#1C2128" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Import from Platform" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Download your data or import a saved export file" FontSize="11" Foreground="#8B949E"/>
                            
                            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                <Button Content="TikTok" HorizontalAlignment="Stretch" CornerRadius="8" Padding="8,10"/>
                                <Button Grid.Column="1" Content="Instagram Reels" HorizontalAlignment="Stretch" CornerRadius="8" Padding="8,10"/>
                                <Button Grid.Column="2" Content="YouTube Shorts" HorizontalAlignment="Stretch" CornerRadius="8" Padding="8,10"/>

                                <Button Grid.Row="1" Content="CSV File" HorizontalAlignment="Stretch" CornerRadius="8" Padding="8,10"/>
                                <Button Grid.Row="1" Grid.Column="1" Content="Excel File" HorizontalAlignment="Stretch" CornerRadius="8" Padding="8,10"/>
                                <Button Grid.Row="1" Grid.Column="2" Content="JSON File" HorizontalAlignment="Stretch" CornerRadius="8" Padding="8,10"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Import Stepper -->
                    <Border Background="#1C2128" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Import Setup" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="We'll help map your columns and clean your data" FontSize="11" Foreground="#8B949E"/>

                            <Grid ColumnDefinitions="*,*,*,*" Margin="0,8,0,0">
                                <StackPanel HorizontalAlignment="Center" Spacing="4">
                                    <Border Width="24" Height="24" CornerRadius="12" Background="#0078D4">
                                        <TextBlock Text="1" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Map Columns" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="4">
                                    <Border Width="24" Height="24" CornerRadius="12" Background="#30363D">
                                        <TextBlock Text="2" FontSize="12" Foreground="#8B949E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Date Parsing" FontSize="11" Foreground="#8B949E"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="4">
                                    <Border Width="24" Height="24" CornerRadius="12" Background="#30363D">
                                        <TextBlock Text="3" FontSize="12" Foreground="#8B949E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Metric Detection" FontSize="11" Foreground="#8B949E"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" HorizontalAlignment="Center" Spacing="4">
                                    <Border Width="24" Height="24" CornerRadius="12" Background="#30363D">
                                        <TextBlock Text="4" FontSize="12" Foreground="#8B949E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Duplicate Handling" FontSize="11" Foreground="#8B949E"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Column: Data Preview & Detected Fields -->
                <StackPanel Spacing="16">
                    <!-- Preview Table -->
                    <Border Background="#1C2128" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Text="Data Preview" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Preview of your imported data (first 10 rows)" FontSize="11" Foreground="#8B949E"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#0D1117" CornerRadius="6" Padding="8,4">
                                    <TextBlock Text="10 of 2,348 rows" FontSize="11" Foreground="#8B949E"/>
                                </Border>
                            </Grid>
                            <ListView x:Name="PreviewListView" Height="220" SelectionMode="None"/>
                        </StackPanel>
                    </Border>

                    <!-- Detected Fields Chips (Reference 2) -->
                    <Border Background="#1C2128" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Detected Fields" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="We've automatically detected and mapped the following fields" FontSize="11" Foreground="#8B949E"/>

                            <WrapGrid Orientation="Horizontal" HorizontalChildrenAlignment="Left" ItemWidth="140" ItemHeight="42">
                                <Border Background="#0D1117" CornerRadius="6" Padding="8,4" Margin="4">
                                    <TextBlock Text="post_id → ID" FontSize="12" Foreground="#58A6FF"/>
                                </Border>
                                <Border Background="#0D1117" CornerRadius="6" Padding="8,4" Margin="4">
                                    <TextBlock Text="platform → Platform" FontSize="12" Foreground="#BC8CFF"/>
                                </Border>
                                <Border Background="#0D1117" CornerRadius="6" Padding="8,4" Margin="4">
                                    <TextBlock Text="posted_at → Date" FontSize="12" Foreground="#7EE787"/>
                                </Border>
                                <Border Background="#0D1117" CornerRadius="6" Padding="8,4" Margin="4">
                                    <TextBlock Text="views → Number" FontSize="12" Foreground="#FFA657"/>
                                </Border>
                                <Border Background="#0D1117" CornerRadius="6" Padding="8,4" Margin="4">
                                    <TextBlock Text="likes → Number" FontSize="12" Foreground="#FFA657"/>
                                </Border>
                                <Border Background="#0D1117" CornerRadius="6" Padding="8,4" Margin="4">
                                    <TextBlock Text="saves → Number" FontSize="12" Foreground="#FFA657"/>
                                </Border>
                            </WrapGrid>
                        </StackPanel>
                    </Border>

                    <!-- Action Bar -->
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                        <Button Content="Validate" CornerRadius="8" Padding="16,8"/>
                        <Button Grid.Column="2" Content="Preview" CornerRadius="8" Padding="16,8"/>
                        <Button Grid.Column="3" Content="Start Import" Style="{ThemeResource AccentButtonStyle}" CornerRadius="8" Padding="20,8"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
