<Page
    x:Class="ReelScope.App.Views.ExperimentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="16,0,16,24">
            <!-- Header and Experiment Config (Reference 5) -->
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                <StackPanel>
                    <TextBlock Text="A/B Test Lab" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="Design, compare, and interpret controlled experiments" FontSize="14" Foreground="#8B949E" Margin="0,4,0,0"/>
                </StackPanel>

                <ComboBox Grid.Column="1" Header="Primary Metric" SelectedIndex="0" CornerRadius="6">
                    <ComboBoxItem Content="Video Completion Rate"/>
                    <ComboBoxItem Content="Engagement Rate"/>
                    <ComboBoxItem Content="Follower Conversion"/>
                </ComboBox>

                <ComboBox Grid.Column="2" Header="Confidence Level" SelectedIndex="0" CornerRadius="6">
                    <ComboBoxItem Content="95%"/>
                    <ComboBoxItem Content="90%"/>
                    <ComboBoxItem Content="99%"/>
                </ComboBox>

                <ComboBox Grid.Column="3" Header="MDE" SelectedIndex="0" CornerRadius="6">
                    <ComboBoxItem Content="5%"/>
                    <ComboBoxItem Content="2%"/>
                    <ComboBoxItem Content="10%"/>
                </ComboBox>

                <ComboBox Grid.Column="4" Header="Statistical Power" SelectedIndex="0" CornerRadius="6">
                    <ComboBoxItem Content="80%"/>
                    <ComboBoxItem Content="90%"/>
                </ComboBox>
            </Grid>

            <!-- Side-by-side Variant Cards (Control A vs Variant B) -->
            <Grid ColumnDefinitions="*,*,1.1*" ColumnSpacing="16">
                <!-- Control A -->
                <Border Background="#1C2128" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1" Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="24" Height="24" CornerRadius="12" Background="#0078D4">
                                <TextBlock Text="A" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Control" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Original content (current)" FontSize="11" Foreground="#8B949E"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Thumbnail & Title -->
                        <Border Height="80" Background="#0D1117" CornerRadius="6" Padding="10">
                            <TextBlock x:Name="TxtControlTitle" Text="Standard Hook (3s)" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Border>

                        <Grid ColumnDefinitions="*,*" RowSpacing="6" ColumnSpacing="6">
                            <StackPanel>
                                <TextBlock Text="Sample Size" FontSize="11" Foreground="#8B949E"/>
                                <TextBlock x:Name="TxtControlN" Text="1,500" FontSize="15" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Conversion" FontSize="11" Foreground="#8B949E"/>
                                <TextBlock x:Name="TxtControlRate" Text="42.1%" FontSize="15" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Variant B -->
                <Border Grid.Column="1" Background="#1C2128" CornerRadius="12" BorderBrush="#8957E5" BorderThickness="1.5" Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="24" Height="24" CornerRadius="12" Background="#8957E5">
                                <TextBlock Text="B" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Variant" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="New thumbnail + shorter hook" FontSize="11" Foreground="#8B949E"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Thumbnail & Title -->
                        <Border Height="80" Background="#0D1117" CornerRadius="6" Padding="10">
                            <TextBlock x:Name="TxtTreatmentTitle" Text="Fast Punchy Hook (1.5s)" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Border>

                        <Grid ColumnDefinitions="*,*" RowSpacing="6" ColumnSpacing="6">
                            <StackPanel>
                                <TextBlock Text="Sample Size" FontSize="11" Foreground="#8B949E"/>
                                <TextBlock x:Name="TxtTreatmentN" Text="1,500" FontSize="15" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Conversion" FontSize="11" Foreground="#8B949E"/>
                                <TextBlock x:Name="TxtTreatmentRate" Text="46.8%" FontSize="15" FontWeight="Bold" Foreground="#3FB950"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Interpretation & Evidence Panel -->
                <Border Grid.Column="2" Background="#1C2128" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Interpretation" FontSize="15" FontWeight="SemiBold"/>
                        <Border Background="#161B22" CornerRadius="8" Padding="12" BorderBrush="#3FB950" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Variant is performing better" FontSize="13" FontWeight="SemiBold" Foreground="#3FB950"/>
                                <TextBlock Text="The variant shows a statistically significant increase in completion rate of +4.7 pp (+11.2% relative lift)." FontSize="11" Foreground="#8B949E" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Probability of improvement: 99.7%" FontSize="12" Foreground="#8B949E"/>
                            <TextBlock Text="Confidence interval: +1.8% to +7.6%" FontSize="12" Foreground="#8B949E"/>
                            <TextBlock Text="Result: Statistically significant" FontSize="12" FontWeight="SemiBold" Foreground="#3FB950"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Statistical KPI Metrics Bar -->
            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12">
                <Border Background="#1C2128" CornerRadius="10" Padding="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Absolute Lift" FontSize="11" Foreground="#8B949E"/>
                        <TextBlock x:Name="TxtAbsLift" Text="+4.7 pp" FontSize="18" FontWeight="Bold" Foreground="#3FB950"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#1C2128" CornerRadius="10" Padding="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Relative Lift" FontSize="11" Foreground="#8B949E"/>
                        <TextBlock x:Name="TxtRelLift" Text="+11.2%" FontSize="18" FontWeight="Bold" Foreground="#3FB950"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#1C2128" CornerRadius="10" Padding="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="95% Confidence Interval" FontSize="11" Foreground="#8B949E"/>
                        <TextBlock x:Name="TxtCI" Text="+1.8% to +7.6%" FontSize="15" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Background="#1C2128" CornerRadius="10" Padding="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="p-value" FontSize="11" Foreground="#8B949E"/>
                        <TextBlock x:Name="TxtPVal" Text="0.0031" FontSize="18" FontWeight="Bold" Foreground="#58A6FF"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Background="#1C2128" CornerRadius="10" Padding="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Significance" FontSize="11" Foreground="#8B949E"/>
                        <Border Background="#238636" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                            <TextBlock Text="Significant (p &lt; 0.05)" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Charts: Conversion Over Time + Bootstrap Distribution -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <!-- Timeline with Confidence Bands -->
                <Border Background="#1C2128" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Conversion Rate Over Time" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Daily conversion rate with 95% confidence bands" FontSize="11" Foreground="#8B949E"/>
                        <Border Height="200" Background="#0D1117" CornerRadius="8">
                            <WebView2 x:Name="TimelineWebView"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Bootstrap Resampling Distribution (10,000 resamples) -->
                <Border Grid.Column="1" Background="#1C2128" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Bootstrap Distribution" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Distribution of lift from 10,000 empirical resamples" FontSize="11" Foreground="#8B949E"/>
                        <Border Height="200" Background="#0D1117" CornerRadius="8">
                            <WebView2 x:Name="BootstrapWebView"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
