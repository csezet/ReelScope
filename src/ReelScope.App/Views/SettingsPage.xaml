<Page
    x:Class="ReelScope.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Padding="16,0,16,24">
            <!-- Header -->
            <StackPanel>
                <TextBlock Text="Settings" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Application, data, model, and export preferences" FontSize="14" Foreground="#8B949E" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 3 Columns Layout (Reference 7) -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                <!-- Column 1: General + Database + Appearance -->
                <StackPanel Spacing="16">
                    <!-- General -->
                    <Border Background="#1C2128" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="General" FontSize="15" FontWeight="SemiBold"/>
                            <ToggleSwitch Header="Start ReelScope at login" IsOn="False"/>
                            <ComboBox Header="Default landing page" SelectedIndex="0" CornerRadius="6" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Overview"/>
                                <ComboBoxItem Content="Posts"/>
                                <ComboBoxItem Content="Cohorts"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Database -->
                    <Border Background="#1C2128" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Database" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Local DuckDB storage location" FontSize="11" Foreground="#8B949E"/>
                            <TextBox x:Name="TxtDbPath" IsReadOnly="True" FontSize="11" CornerRadius="6"/>
                            <ProgressBar Value="18" Maximum="100" Height="6" CornerRadius="3" Foreground="#0078D4"/>
                            <TextBlock Text="Used 1.8 GB of 10 GB (18%)" FontSize="11" Foreground="#8B949E"/>
                            
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Content="Open Folder" HorizontalAlignment="Stretch" CornerRadius="6"/>
                                <Button Grid.Column="1" Content="Reset Data" Click="OnResetDbClicked" HorizontalAlignment="Stretch" CornerRadius="6"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Appearance -->
                    <Border Background="#1C2128" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Appearance" FontSize="15" FontWeight="SemiBold"/>
                            <ComboBox Header="Theme" SelectedIndex="1" CornerRadius="6" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="System Default"/>
                                <ComboBoxItem Content="Dark (Fluent 2)"/>
                                <ComboBoxItem Content="Light"/>
                            </ComboBox>
                            <Slider Header="Acrylic blur strength (80%)" Minimum="0" Maximum="100" Value="80"/>
                            <ToggleSwitch Header="Accent glow effects" IsOn="True"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Column 2: Data Sources + Analytics Engine + Notifications -->
                <StackPanel Spacing="16">
                    <!-- Data Sources -->
                    <Border Background="#1C2128" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Data Sources" FontSize="15" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="8" Height="8" CornerRadius="4" Background="#3FB950" VerticalAlignment="Center"/>
                                <TextBlock Text="TikTok Connected" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="8" Height="8" CornerRadius="4" Background="#3FB950" VerticalAlignment="Center"/>
                                <TextBlock Text="Instagram Reels Connected" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="8" Height="8" CornerRadius="4" Background="#3FB950" VerticalAlignment="Center"/>
                                <TextBlock Text="YouTube Shorts Connected" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Analytics Engine Settings -->
                    <Border Background="#1C2128" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Analytics Engine" FontSize="15" FontWeight="SemiBold"/>
                            <ComboBox Header="Default Analysis Window" SelectedIndex="1" CornerRadius="6" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Last 7 days"/>
                                <ComboBoxItem Content="Last 28 days"/>
                                <ComboBoxItem Content="Last 90 days"/>
                            </ComboBox>
                            <Slider Header="Confidence Threshold (70%)" Minimum="50" Maximum="99" Value="70"/>
                        </StackPanel>
                    </Border>

                    <!-- Notifications -->
                    <Border Background="#1C2128" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Notifications" FontSize="15" FontWeight="SemiBold"/>
                            <ToggleSwitch Header="Data sync notifications" IsOn="True"/>
                            <ToggleSwitch Header="Analysis complete alerts" IsOn="True"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Column 3: System Status + Export + About (Reference 7) -->
                <StackPanel Spacing="16">
                    <!-- System Status Card -->
                    <Border Background="#1C2128" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="14">
                            <TextBlock Text="System Status" FontSize="15" FontWeight="SemiBold"/>
                            
                            <!-- Python Engine -->
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#3FB950" VerticalAlignment="Center"/>
                                    <TextBlock Text="Python Analytics Engine" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtEngineStatus" Text="Running • Python 3.12.10" FontSize="11" Foreground="#8B949E" Margin="16,0,0,0"/>
                            </StackPanel>

                            <!-- DuckDB -->
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#3FB950" VerticalAlignment="Center"/>
                                    <TextBlock Text="DuckDB Database" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtDuckDbStatus" Text="Connected • Local Database Active" FontSize="11" Foreground="#8B949E" Margin="16,0,0,0"/>
                            </StackPanel>

                            <!-- Application Version -->
                            <StackPanel Spacing="2">
                                <TextBlock Text="Application Version" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="ReelScope v1.0.0 (WinUI 3)" FontSize="11" Foreground="#8B949E"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Export Settings -->
                    <Border Background="#1C2128" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Export" FontSize="15" FontWeight="SemiBold"/>
                            <ComboBox Header="Default Format" SelectedIndex="0" CornerRadius="6" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="CSV (.csv)"/>
                                <ComboBoxItem Content="Excel (.xlsx)"/>
                                <ComboBoxItem Content="HTML Report"/>
                            </ComboBox>
                            <ToggleSwitch Header="Include visualizations" IsOn="True"/>
                        </StackPanel>
                    </Border>

                    <!-- About -->
                    <Border Background="#1C2128" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="About" FontSize="15" FontWeight="SemiBold"/>
                            <HyperlinkButton Content="View Release Notes (GitHub)"/>
                            <HyperlinkButton Content="Check for Updates"/>
                            <HyperlinkButton Content="Architecture Documentation"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
