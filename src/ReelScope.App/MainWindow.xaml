<Window
    x:Class="ReelScope.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ReelScope - Creator Analytics Workstation"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <!-- Windows 11 Fluent 2 NavigationView -->
        <NavigationView
            x:Name="NavView"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            ItemInvoked="NavView_ItemInvoked">

            <!-- App Brand Header -->
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="16,14,16,14">
                    <Border Width="32" Height="32" CornerRadius="8" Background="#0078D4">
                        <FontIcon Glyph="&#xE768;" FontSize="16" Foreground="White"/>
                    </Border>
                    <TextBlock Text="ReelScope" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </NavigationView.PaneHeader>

            <!-- Navigation Items matching References 1-7 -->
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Overview" Tag="Overview">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Import" Tag="Import">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE898;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Content Analytics" Tag="Posts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Cohorts" Tag="Cohorts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="A/B Tests" Tag="Experiments">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC0A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Segments" Tag="Segments">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C3;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="SQL Lab" Tag="SqlLab">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE943;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Bottom Creator Profile Selector -->
            <NavigationView.PaneFooter>
                <Border Margin="12,8,12,12" Background="#1C2128" CornerRadius="8" Padding="10,8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Width="28" Height="28" CornerRadius="14" Background="#30363D">
                            <FontIcon Glyph="&#xE77B;" FontSize="14" Foreground="#8B949E"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Creator Account" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="@alexcreates" FontSize="11" Foreground="#8B949E"/>
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </NavigationView.PaneFooter>

            <!-- Main Content Container with Top Header Bar -->
            <Grid RowDefinitions="Auto,*">
                <!-- Top Global Action Bar -->
                <Grid Grid.Row="0" Margin="24,12,24,12" ColumnDefinitions="*,Auto,Auto">
                    <!-- Search Box (Ctrl + K) -->
                    <TextBox
                        Width="320"
                        HorizontalAlignment="Left"
                        PlaceholderText="Search posts, topics, or insights...  Ctrl + K"
                        CornerRadius="8"
                        VerticalAlignment="Center"/>

                    <!-- Date Range Picker -->
                    <DropDownButton Grid.Column="1" Content="May 1, 2024 - May 31, 2024" Margin="12,0,12,0" CornerRadius="8">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Current Month (May 2024)" />
                                <MenuFlyoutItem Text="Last 30 Days" />
                                <MenuFlyoutItem Text="Year to Date" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <!-- Quick Window Chips -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                        <Button Content="7D" CornerRadius="6" Padding="12,4"/>
                        <Button Content="28D" CornerRadius="6" Padding="12,4" Style="{ThemeResource AccentButtonStyle}"/>
                        <Button Content="90D" CornerRadius="6" Padding="12,4"/>
                        <Button Content="1Y" CornerRadius="6" Padding="12,4"/>
                    </StackPanel>
                </Grid>

                <!-- Page Navigation Frame -->
                <Frame x:Name="ContentFrame" Grid.Row="1" Margin="12,0,12,12"/>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
